FROM oven/bun:1.4-alpine AS base

WORKDIR /app

# Install dependencies in a separate layer so source changes do not invalidate
# the dependency cache.
FROM base AS dependencies

COPY auth-service/package.json auth-service/bun.lock ./
RUN bun install --frozen-lockfile --production

# The runtime image contains only production dependencies and application files.
FROM base AS runtime

ENV NODE_ENV=production
ENV PORT=5053
ENV GRPC_PORT=50053

COPY --from=dependencies /app/node_modules ./node_modules
COPY auth-service/package.json auth-service/bun.lock ./
COPY auth-service/src ./src
COPY proto ./proto

EXPOSE 5053 50053

CMD ["bun", "run", "src/app.ts"]
