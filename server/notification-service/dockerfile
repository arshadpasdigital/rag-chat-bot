FROM oven/bun:1.4-alpine AS base

WORKDIR /app

# Install dependencies in a separate layer so source changes do not invalidate
# the dependency cache.
FROM base AS dependencies

COPY notification-service/package.json notification-service/bun.lock ./
RUN bun install --frozen-lockfile --production

# The runtime image contains only production dependencies and application files.
FROM base AS runtime

ENV NODE_ENV=production
ENV PORT=5052
ENV GRPC_PORT=50052

COPY --from=dependencies /app/node_modules ./node_modules
COPY notification-service/package.json notification-service/bun.lock ./
COPY notification-service/src ./src
COPY proto ./proto


EXPOSE 5052 50052

CMD ["bun", "run", "src/app.ts"]
